# Telegram (primary notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional channels (leave blank to disable)
DISCORD_WEBHOOK_URL=

# Email alerts (Gmail: use an App Password — https://myaccount.google.com/apppasswords)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=sivaduddempudi@gmail.com
EMAIL_PASSWORD=
EMAIL_TO=sivaduddempudi@gmail.com
# Comma-separated for multiple recipients, e.g.:
# EMAIL_TO=sivaduddempudi@gmail.com,friend1@gmail.com,friend2@gmail.com

# Runtime
DATABASE_PATH=data/internships.db
COMPANIES_PATH=companies/companies.yaml
LOG_LEVEL=INFO
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
ENABLE_DASHBOARD=true
ENABLE_DISCOVERY=true

# Polling defaults (seconds) — lowest practical cadence
POLL_BUSINESS_HOURS=60
POLL_OFF_HOURS=120
POLL_HOT=30
POLL_INACTIVE=300

# Target terms (comma-separated)
TARGET_TERMS=Summer 2027,Fall 2026,Winter 2027,Spring 2027

# Location filter: us_canada (default) or any
LOCATION_FILTER=us_canada
